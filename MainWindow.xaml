<Window
    x:Class="RnxFotoo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RnxFotoo">
    <Grid x:Name="Root" Background="{StaticResource CanvasBrush}" RequestedTheme="Dark" KeyboardAcceleratorPlacementMode="Hidden"
          SizeChanged="Root_SizeChanged" KeyDown="Root_KeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="AddFolderShortcut_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenShortcut_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="24,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" Background="#3A3028" CornerRadius="6">
                    <FontIcon Glyph="&#xE91B;" FontSize="13" Foreground="{StaticResource WarmBrush}" />
                </Border>
                <TextBlock Text="RnxFotoo" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Header" Grid.Row="1" Margin="24,16,24,22" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Фоторамка" FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="HeaderSubtitle" Text="Слайд-шоу из папок и интернета"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="PaneButton" Grid.Column="1" Style="{StaticResource IconButton}" Visibility="Collapsed"
                    VerticalAlignment="Center" Click="PaneButton_Click" AutomationProperties.Name="Источники и настройки"
                    ToolTipService.ToolTip="Источники и настройки">
                <FontIcon Glyph="&#xE713;" FontSize="18" />
            </Button>
            <Button x:Name="FullScreenButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" MinHeight="42"
                    VerticalAlignment="Center" Click="FullScreenButton_Click" AutomationProperties.Name="На весь экран"
                    ToolTipService.ToolTip="На весь экран (F11)">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE740;" FontSize="15" />
                    <TextBlock x:Name="FullScreenLabel" Text="На весь экран" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="Notice" Grid.Row="2" Margin="24,0,24,12" Severity="Warning" IsOpen="False" />

        <SplitView x:Name="Workspace" Grid.Row="3" PanePlacement="Right" DisplayMode="Inline" IsPaneOpen="True"
                   OpenPaneLength="348" PaneBackground="{StaticResource CanvasBrush}">
            <SplitView.Pane>
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,0,24,22" x:Name="Sidebar">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="17" Foreground="{StaticResource WarmBrush}" />
                                    <TextBlock Text="Локальные папки" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" AutomationProperties.HeadingLevel="Level2" />
                                </StackPanel>
                                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Height="32" Width="32"
                                        HorizontalAlignment="Right" Click="RefreshButton_Click" AutomationProperties.Name="Обновить список фотографий"
                                        ToolTipService.ToolTip="Обновить список фотографий">
                                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                                </Button>
                            </Grid>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="14,12">
                                <StackPanel Spacing="11">
                                    <StackPanel x:Name="EmptyFolders" Spacing="3" Margin="0,1,0,2">
                                        <TextBlock Text="Папки не добавлены" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Выберите папку с фотографиями на этом компьютере." TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel x:Name="FolderRows" Spacing="6" Visibility="Collapsed" />
                                    <Button x:Name="AddFolderButton" HorizontalAlignment="Stretch" Height="39" CornerRadius="7"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="AddFolderButton_Click" AutomationProperties.Name="Добавить папку">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <SymbolIcon Symbol="Add" Width="16" Height="16" />
                                            <TextBlock Text="Добавить папку" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Rectangle Height="1" Fill="{StaticResource EdgeBrush}" />
                                    <Grid>
                                        <TextBlock Text="Включать подпапки" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="SubfoldersToggle" Style="{StaticResource SettingsSwitch}"
                                                      Toggled="SubfoldersToggle_Toggled" AutomationProperties.Name="Включать подпапки" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="9" Height="30">
                                <FontIcon Glyph="&#xE774;" FontSize="17" Foreground="{StaticResource WarmBrush}" />
                                <TextBlock Text="Интернет" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="14,12">
                                <StackPanel Spacing="11">
                                    <TextBlock x:Name="InternetHint" Text="Яндекс.Картинки, Google Images, Pinterest или другой сайт."
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                    <StackPanel x:Name="SourceRows" Spacing="6" Visibility="Collapsed" />
                                    <Button HorizontalAlignment="Stretch" Height="39" CornerRadius="7"
                                            Click="AddOnlineSource_Click" AutomationProperties.Name="Добавить интернет-источник">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <SymbolIcon Symbol="Add" Width="16" Height="16" />
                                            <TextBlock Text="Добавить интернет-источник" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="9" Height="30">
                                <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{StaticResource WarmBrush}" />
                                <TextBlock Text="Слайд-шоу" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="14,8">
                                <StackPanel>
                                    <Grid MinHeight="48" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Длительность кадра" VerticalAlignment="Center" />
                                        <ComboBox x:Name="IntervalBox" Grid.Column="1" Width="112" VerticalAlignment="Center"
                                                  SelectionChanged="IntervalBox_SelectionChanged" AutomationProperties.Name="Длительность кадра" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource EdgeBrush}" />
                                    <Grid MinHeight="48" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Масштаб фото" VerticalAlignment="Center" />
                                        <ComboBox x:Name="FitBox" Grid.Column="1" Width="112" VerticalAlignment="Center"
                                                  SelectionChanged="FitBox_SelectionChanged" AutomationProperties.Name="Масштаб фото">
                                            <ComboBoxItem Content="Вписать" />
                                            <ComboBoxItem Content="Заполнить" />
                                        </ComboBox>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource EdgeBrush}" />
                                    <Grid MinHeight="47">
                                        <TextBlock Text="Случайный порядок" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ShuffleToggle" Style="{StaticResource SettingsSwitch}" Toggled="ShuffleToggle_Toggled"
                                                      AutomationProperties.Name="Случайный порядок" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource EdgeBrush}" />
                                    <Grid MinHeight="47">
                                        <TextBlock Text="Плавная смена кадров" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="FadeToggle" Style="{StaticResource SettingsSwitch}" Toggled="FadeToggle_Toggled"
                                                      AutomationProperties.Name="Плавная смена кадров" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource EdgeBrush}" />
                                    <Grid MinHeight="47">
                                        <TextBlock Text="Часы и дата" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="ClockToggle" Style="{StaticResource SettingsSwitch}" Toggled="ClockToggle_Toggled"
                                                      AutomationProperties.Name="Часы и дата" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <Grid x:Name="PreviewLayout" Margin="24,0,24,22" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="FrameCard" CornerRadius="13" Background="#101113" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                    <ContentControl x:Name="PhotoFocus" IsTabStop="True" UseSystemFocusVisuals="False"
                                    AutomationProperties.Name="Предпросмотр слайд-шоу" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <Grid x:Name="PhotoSurface" Background="#101113" PointerMoved="PhotoSurface_PointerMoved"
                              Tapped="PhotoSurface_Tapped" DoubleTapped="PhotoSurface_DoubleTapped">
                            <Image x:Name="DemoPhoto" Source="ms-appx:///Assets/Preview.jpg" Stretch="UniformToFill" />
                            <Image x:Name="PhotoUnderlay" AutomationProperties.AccessibilityView="Raw" />
                            <Image x:Name="CurrentPhoto" AutomationProperties.AccessibilityView="Raw" />

                            <Border x:Name="ExampleBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17" Padding="11,6"
                                    CornerRadius="6" Background="#C017181A" IsHitTestVisible="False">
                                <TextBlock Text="Пример кадра" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <Grid x:Name="ClockOverlay" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#7A0C0B09" Offset="0.56" />
                                        <GradientStop Color="#BC0C0B09" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <StackPanel x:Name="ClockText" Margin="23,40,23,23">
                                    <TextBlock x:Name="ClockTime" FontFamily="Segoe UI Variable Display" FontSize="66" FontWeight="SemiLight"
                                               LineHeight="74" LineStackingStrategy="BlockLineHeight" Foreground="#FFFFFAF2" />
                                    <TextBlock x:Name="ClockDate" Margin="3,0,0,0" FontSize="15" FontWeight="Medium" Foreground="#FFF2EAE0" />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="FullScreenControls" Visibility="Collapsed" Background="#E2222326" BorderBrush="#55777777"
                                    BorderThickness="1" CornerRadius="11" Padding="6" Margin="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" PointerEntered="FullScreenControls_PointerEntered"
                                    PointerExited="FullScreenControls_PointerExited">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button x:Name="FullPrevious" Style="{StaticResource IconButton}" Click="Previous_Click"
                                            AutomationProperties.Name="Предыдущий кадр" ToolTipService.ToolTip="Предыдущий кадр (←)">
                                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="FullPlay" Style="{StaticResource IconButton}" Click="Play_Click" AutomationProperties.Name="Пауза">
                                        <FontIcon x:Name="FullPlayIcon" Glyph="&#xE769;" FontSize="17" Foreground="{StaticResource WarmBrush}" />
                                    </Button>
                                    <Button x:Name="FullNext" Style="{StaticResource IconButton}" Click="Next_Click"
                                            AutomationProperties.Name="Следующий кадр" ToolTipService.ToolTip="Следующий кадр (→)">
                                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                                    </Button>
                                    <Rectangle Width="1" Height="20" Fill="#555555" Margin="4,0" />
                                    <Button Style="{StaticResource IconButton}" Click="FullScreenButton_Click"
                                            AutomationProperties.Name="Выйти из полноэкранного режима" ToolTipService.ToolTip="Выйти из полноэкранного режима (Esc)">
                                        <FontIcon Glyph="&#xE73F;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ContentControl>
                </Border>

                <Border x:Name="PlaybackBar" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}"
                        BorderThickness="1" CornerRadius="11" MinHeight="65">
                    <Grid>
                        <Grid Margin="13,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="PhotoDetails" ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PhotoDetailsIcon" Background="#353027" Width="34" Height="34" CornerRadius="8">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{StaticResource WarmBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="PhotoName" Text="Нет фотографий" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PhotoFolder" Text="Добавьте папку или интернет-источник" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Click="Previous_Click"
                                        AutomationProperties.Name="Предыдущий кадр" ToolTipService.ToolTip="Предыдущий кадр (←)">
                                    <FontIcon Glyph="&#xE892;" FontSize="17" />
                                </Button>
                                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Width="44" Height="40" Padding="0"
                                        Click="Play_Click" AutomationProperties.Name="Воспроизвести">
                                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="17" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Click="Next_Click"
                                        AutomationProperties.Name="Следующий кадр" ToolTipService.ToolTip="Следующий кадр (→)">
                                    <FontIcon Glyph="&#xE893;" FontSize="17" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="PhotoCounter" Grid.Column="2" Text="0 / 0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                        </Grid>
                        <ProgressBar x:Name="PlaybackProgress" VerticalAlignment="Bottom" Height="2" MinHeight="2" Margin="8,0,8,1"
                                     Foreground="{StaticResource WarmBrush}" Background="Transparent" Maximum="100"
                                     AutomationProperties.Name="Время до следующего кадра" />
                    </Grid>
                </Border>
            </Grid>
        </SplitView>
    </Grid>
</Window>
