<Window
    x:Class="RnxFotoo.OnlineSourceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Интернет-источник — RnxFotoo">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource CanvasBrush}" Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="BackButton_Click" IsEnabled="False"
                    ToolTipService.ToolTip="Назад" AutomationProperties.Name="Назад">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <ComboBox x:Name="Providers" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center"
                      AutomationProperties.Name="Поиск изображений">
                <ComboBoxItem Content="Яндекс.Картинки" />
                <ComboBoxItem Content="Google Images" />
                <ComboBoxItem Content="Pinterest" />
            </ComboBox>
            <TextBox x:Name="Query" Grid.Column="2" VerticalAlignment="Center" KeyDown="Query_KeyDown"
                     PlaceholderText="Запрос или ссылка на страницу" AutomationProperties.Name="Запрос или ссылка на страницу" />
            <Button x:Name="GoButton" Grid.Column="3" Content="Открыть" VerticalAlignment="Center"
                    Click="GoButton_Click" IsEnabled="False" />
        </Grid>

        <TextBlock x:Name="PageAddress" Grid.Row="1" Foreground="{StaticResource MutedTextBrush}"
                   FontSize="12" TextTrimming="CharacterEllipsis" />
        <WebView2 x:Name="Browser" Grid.Row="2" />

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource SecondaryTextBrush}" />
            <Button x:Name="ImportButton" Grid.Column="1" Content="Добавить в фоторамку" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ImportButton_Click" />
        </Grid>
    </Grid>
</Window>
