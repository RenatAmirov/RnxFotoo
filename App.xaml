<Application
    x:Class="RnxFotoo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FFC483</Color>
            <Color x:Key="SystemAccentColorLight2">#FFC483</Color>
            <x:Double x:Key="ToggleSwitchThemeMinWidth">44</x:Double>
            <SolidColorBrush x:Key="CanvasBrush" Color="#161719" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#212225" />
            <SolidColorBrush x:Key="EdgeBrush" Color="#35373B" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F2ED" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BDBDC5" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#999BA4" />
            <SolidColorBrush x:Key="WarmBrush" Color="#FFC483" />

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource WarmBrush}" />
                <Setter Property="Foreground" Value="#22170F" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SettingsSwitch" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
